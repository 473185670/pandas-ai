# PandasAI backend environment variables
# Copy to .env and fill in the one you have:

# Gemini (RECOMMENDED — gemini-1.5-flash is FREE: 15 RPM, 1500 req/day)
GEMINI_API_KEY=

# OpenAI (gpt-4o-mini is cheap + high quality)
OPENAI_API_KEY=

# Anthropic (claude-3-5-haiku — also cheap + fast)
ANTHROPIC_API_KEY=

# Local Ollama (free, offline) — set USE_OLLAMA=1 if Ollama running locally
USE_OLLAMA=
OLLAMA_HOST=http://localhost:11434

# CORS — frontend origin(s), comma-separated
CORS_ORIGINS=*

# Port (Render sets this automatically)
PORT=8000
